# Copy to .env (never committed). Local defaults work without any cloud account.
TP_DATA_DIR=./data
TP_LAKE_BACKEND=local      # local | azure
# TP_ADLS_ACCOUNT_URL=https://<account>.blob.core.windows.net   (azure backend; auth via DefaultAzureCredential)
# TP_LAKE_CONTAINER=lake
TP_USER_AGENT=transitpulse-de/0.1 (portfolio project; your-email@example.com)
TP_LOG_FORMAT=json          # json | text
TP_ALERT_WEBHOOK=           # Slack/Discord webhook; empty = log only
